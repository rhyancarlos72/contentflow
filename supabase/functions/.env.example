# Secrets das Edge Functions: `supabase secrets set --env-file supabase/functions/.env`
# IA — escolha um provedor (sem AI_PROVIDER: usa Gemini se GEMINI_API_KEY existir)
AI_PROVIDER=gemini
# Google Gemini (plano gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Claude (pago): https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
APP_URL=https://app.seudominio.com.br
APP_ORIGIN=https://app.seudominio.com.br
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_PRO=price_...
RESEND_API_KEY=
EMAIL_FROM=ContentFlow AI <lembretes@seudominio.com.br>
